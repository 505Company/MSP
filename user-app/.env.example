# Server-side only. Never expose this value with a NEXT_PUBLIC_ prefix.
INTELION_API_KEY=
INTELION_API_BASE_URL=https://rus.aiapi.intelion.cloud/v1
INTELION_MODEL=qwen3.8-27b

# Explicit RouterAI connection for the slide-generation pilot (--routerai).
# Independent of Intelion import and of existing project snapshots.
ROUTERAI_API_KEY=
ROUTERAI_MODEL=qwen/qwen3.8-27b
ROUTERAI_PROVIDER=deepinfra
